  <item>
    <title>MDI Weekly Update – Week of Nov 9, 2026</title>
    <link>https://bimja.github.io/mdi-news/posts/2026-11-13/</link>
    <guid isPermaLink="true">https://bimja.github.io/mdi-news/posts/2026-11-13/</guid>
    <pubDate>Fri, 13 Nov 2026 09:00:00 -0600</pubDate>
